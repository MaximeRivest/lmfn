#!/usr/bin/env bash
# The project venv: lmfn (editable), lmcc (editable, from ../lmcc), lm15 at
# the release lmcc pins, verifiers at a pinned commit, the alphabet-sort
# example, and pytest.
set -euo pipefail
cd "$(dirname "$0")"
LMCC=../lmcc/python
LM15_PIN=$(grep -o '"lm15[=@][^"]*"' $LMCC/pyproject.toml | tr -d '"')
[ -x .venv/bin/python ] || uv venv -q .venv --python 3.12
# verifiers at the commit the harness was built against (its v1 API moves fast)
VERIFIERS_PIN="verifiers @ git+https://github.com/PrimeIntellect-ai/verifiers@1863cfbdc75aa3ce708f534cf633e69a5f08fdd6"
uv pip install -q --python .venv/bin/python -e . -e "$LMCC" "$LM15_PIN" pytest "$VERIFIERS_PIN" \
    -e examples/alphabet_sort_lmfn
.venv/bin/python -c 'import lmfn, lmcc, lm15; print("lmfn", lmfn.__version__, "| lmcc", lmcc.__version__, "| lm15", lm15.__version__)'
